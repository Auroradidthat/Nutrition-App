{
  "name": "nutrition-app",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:container": "npm run db:migrate:local && wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nutrition-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nutrition-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "version": "0.3.2"
}
